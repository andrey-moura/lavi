@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(Lavi_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include")
set(Lavi_LIBRARIES Lavi::lavi-lang)

include("${CMAKE_CURRENT_LIST_DIR}/LaviTargets.cmake")

add_compile_definitions(
    ANDY_VERSION="${ANDY_VERSION}"
    ANDY_BUILD_TYPE="${ANDY_BUILD_TYPE}"
    ANDY_CPP_VERSION="${ANDY_CPP_VERSION}"
    ANDY_COMPILER="${ANDY_COMPILER}"
    LAVI_VERSION="${LAVI_PROJECT_VERSION}"
)

function(lavi_library name)
    set(sources ${ARGN})
    set(lavi_sources)

    foreach(source IN LISTS sources)
        if(source MATCHES "\\.hpp$")
            get_filename_component(filename "${source}" NAME_WE)
            set(output "${CMAKE_CURRENT_BINARY_DIR}/lavi/${filename}.cpp")

            add_custom_command(
                OUTPUT "${output}"
                COMMAND lavi cxx "${source}" "${output}"
                DEPENDS "${source}"
                VERBATIM
            )

            list(APPEND lavi_sources "${output}")
        else()
            list(APPEND lavi_sources "${source}")
        endif()
    endforeach()

    add_library(${name} ${lavi_sources})
endfunction()