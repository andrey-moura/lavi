// Called as 'lavi project run <project> <name> <output directory> <header>...'
//
// Generates <output directory>/<header name>.cpp for each header, with the Lavi classes of the classes it
// declares, and <output directory>/bindings.cpp, with the extension loaded by 'import :<name>'.
if __args__.size < 7
  out 'Usage: lavi cxx <name> <output directory> <header>...'
  return 1
end

var name = __args__[4]
var output_directory = Path.new(__args__[5])

fn debug(message)
  out message
end

// The name of the header without the directories and the extensions, like NAME_WE of CMake.
fn header_name(header_path)
  var parts = header_path.split('/')
  var file_name = parts[parts.size - 1]

  return file_name.split('.')[0]
end

// Generates the source of a header and returns the bindings of its classes.
fn generate_header(header_path)
  unless File.exists?(header_path)
    throw "Input file '${header_path}' not found."
  end

  debug "Parsing ${header_path}..."

  var lexer = CXX::Lexer.new(File.read(header_path))
  var parser = CXX::Parser.new(lexer.tokens)

  // The generated source includes the header by its absolute path
  var absolute_header_path = Dir.current.path / header_path
  var generator = CXX::Generator.new(parser.unit, absolute_header_path.to_string)
  var output_path = output_directory / "${header_name(header_path)}.cpp"

  generator.bindings.each do (binding)
    debug "  class ${binding.name}"

    binding.methods.each do (method)
      debug "    ${method.lavi_name}"
    end
  end

  debug "Generating ${output_path}..."

  File.create(output_path).write(generator.generate)

  return generator.bindings
end

var bindings = []
var i = 6

loop while i < __args__.size
  generate_header(__args__[i]).each do (binding)
    bindings.push(binding)
  end

  i += 1
end

var bindings_path = output_directory / 'bindings.cpp'

debug "Generating ${bindings_path}..."

File.create(bindings_path).write(CXX::ExtensionGenerator.new(name, bindings).generate)

// The value of the last expression is the exit code
0
