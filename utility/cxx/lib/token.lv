namespace CXX
  class Token
    var content = null
    var line = 0

    enum Kind
      comment
      preprocessor
      keyword
      identifier
      integer_literal
      floating_literal
      character_literal
      string_literal
      boolean_literal
      pointer_literal
      punctuator
      end_of_file
    end

    fn init(k, c)
      kind = k
      content = c
    end

    fn literal?
      integer_literal? || floating_literal? || character_literal? || string_literal? || boolean_literal? || pointer_literal?
    end

    fn to_string
      var limited_content = content.to_string.slice(0, 25)

      if limited_content.size < content.to_string.size
        limited_content += "..."
      end

      return "${kind}(${limited_content.inspect})"
    end
  end
end
