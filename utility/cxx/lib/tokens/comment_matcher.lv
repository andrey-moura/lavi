namespace CXX
  namespace Tokens
    // Matcher for comment tokens.
    class CommentMatcher extends Matcher
      fn match?(source)
        return source.starts_with?("//") || source.starts_with?("/*")
      end

      fn extract(source)
        var end_index = -1

        if source.starts_with?('/*')
          end_index = source.index('*/', 2)
          end_index += 2 if end_index != -1
        else
          end_index = source.index("\n", 2)
        end

        CXX::Token.new(:comment, take(source, end_index))
      end
    end
  end
end
