#include 'tokens/matcher'
#include 'tokens/*'

namespace CXX
  class Lexer
    var source = null
    var matchers = null
    var tokens = []
    var line = 1

    fn init(f)
      source = f

      var classes = CXX::Tokens::Matcher.subclasses

      matchers = classes.map do (token_class)
        token_class.new
      end

      tokenize
    end

    fn whitespace?
      var c = source.front

      return false if c == null
      return c.space?
    end

    fn discard_whitespaces
      loop while whitespace?
        line += 1 if source.front == "\n"
        source.pop_front
      end
    end

    // Counts the line breaks inside a token, such as in comments, preprocessor directives and raw strings.
    fn count_lines(content)
      var position = content.find("\n", 0)

      loop while position != -1
        line += 1
        position = content.find("\n", position + 1)
      end
    end

    fn find_matcher
      matchers.find do (matcher)
        matcher.match?(source)
      end
    end

    fn read_next_token
      discard_whitespaces

      var matcher = find_matcher

      if matcher == null
        throw "No matching token found for source: ${source.slice(0, 20).inspect}"
      end

      var token = matcher.extract(source)

      token.line = line
      count_lines(token.content)

      return token
    end

    fn tokenize
      tokens.reserve(300)

      loop while true
        var token = read_next_token

        tokens.push(token)

        break if token.end_of_file?
      end
    end
  end
end
