namespace CXX
  // A class declared in the C++ header which will be created as a Lavi class.
  class Binding
    // The C++ names of all the namespaces and the class, such as ['lavi', 'gui', 'window'].
    var cxx_scope = []
    // The C++ names of the namespaces and the class, such as ['gui', 'window'], without the 'lavi' namespace.
    var cxx_path = []
    // The Lavi names of the namespaces and the class, such as ['GUI', 'Window'].
    var lavi_path = []
    // The public methods (CXX::Method).
    var methods = []
    // The parameters of the constructor (CXX::Parameter), which are the parameters of init. Empty when the
    // class declares no constructor.
    var constructor_parameters = []

    fn init(s, c, l, m, p)
      cxx_scope = s
      cxx_path = c
      lavi_path = l
      methods = m
      constructor_parameters = p
    end

    // The name of the Lavi class, such as 'GUI::Window'.
    fn name
      lavi_path.join('::')
    end

    // The qualified name of the C++ class, such as 'lavi::gui::window'.
    fn cxx_name
      cxx_scope.join('::')
    end

    // The C++ identifier for the class, such as 'gui_window'.
    fn identifier
      cxx_path.join('_')
    end
  end

  // Generates the C++ source which creates the Lavi classes for the classes declared in a header, like the
  // classes in src/classes of the Lavi language.
  //
  // The 'lavi' namespace is ignored, the other namespaces are uppercased and the classes are converted to
  // PascalCase, so 'lavi::gui::window' is created as 'GUI::Window'.
  class Generator
    var header_path = null
    var bindings = []

    // header_path is the path of the header included by the generated source.
    fn init(unit, h)
      header_path = h

      var empty = []

      collect(unit, empty, empty, empty)
    end

    // Collects the classes declared in the children of a node. cxx_scope has all the C++ names, cxx_path and
    // lavi_path don't have the 'lavi' namespace.
    fn collect(node, cxx_scope, cxx_path, lavi_path)
      node.children.each do (child)
        if child.namespacedecl?
          collect_namespace(child, cxx_scope, cxx_path, lavi_path)
        else if child.linkagedecl?
          collect(child, cxx_scope, cxx_path, lavi_path)
        else if child.context?
          collect(child, cxx_scope, cxx_path, lavi_path)
        else if child.classdecl?
          collect_class(child, cxx_scope, cxx_path, lavi_path)
        end
      end
    end

    fn collect_namespace(namespace_node, cxx_scope, cxx_path, lavi_path)
      var inner_cxx_scope = copy(cxx_scope)
      var inner_cxx_path = copy(cxx_path)
      var inner_lavi_path = copy(lavi_path)

      // Anonymous namespaces have no name
      if namespace_node.decname != null
        namespace_node.decname.split('::').each do (part)
          inner_cxx_scope.push(part)

          // The 'lavi' namespace is ignored
          unless inner_cxx_path.empty? && part == 'lavi'
            inner_cxx_path.push(part)
            inner_lavi_path.push(part.upper)
          end
        end
      end

      collect(namespace_node.child_from_type(:context), inner_cxx_scope, inner_cxx_path, inner_lavi_path)
    end

    fn collect_class(class_node, cxx_scope, cxx_path, lavi_path)
      var body = class_node.child_from_type(:context)

      // Forward declarations are defined elsewhere
      return if body == null

      var class_cxx_scope = copy(cxx_scope)
      var class_cxx_path = copy(cxx_path)
      var class_lavi_path = copy(lavi_path)

      class_cxx_scope.push(class_node.decname)
      class_cxx_path.push(class_node.decname)
      class_lavi_path.push(pascal_case(class_node.decname))

      var methods = collect_methods(class_node, body)
      var constructor_parameters = collect_constructor_parameters(class_node, body)

      bindings.push(CXX::Binding.new(class_cxx_scope, class_cxx_path, class_lavi_path, methods, constructor_parameters))

      // Nested classes
      collect(body, class_cxx_scope, class_cxx_path, class_lavi_path)
    end

    // Methods

    // The public methods of the class, which are bound as Lavi functions. Constructors are bound by init.
    fn collect_methods(class_node, body)
      var class_name = class_node.decname
      var methods = []
      // The bound names, to find overloads
      var names = []
      var access = 'private'

      access = 'public' unless class_node.content == 'class'

      body.children.each do (member)
        if member.access?
          access = member.content
        else if member.fn_decl? && access == 'public'
          var method = method_from(member, class_name)

          if method != null
            var key = "${method.class_function} ${method.lavi_name}"

            if names.include?(key)
              throw "${class_name}::${method.name}: overloaded methods are not supported"
            end

            names.push(key)
            methods.push(method)
          end
        end
      end

      return methods
    end

    // The method of a member function, or null when it is not bound: constructors, destructors, deleted
    // functions and friends.
    fn method_from(member, class_name)
      var name = member.decname
      var where = "${class_name}::${name}"

      return null if has_specifier?(member, 'friend')
      return null if has_qualifier?(member, '= delete')

      // Constructors, destructors and conversion operators have no return type
      if member.child_from_type(:decltype) == null
        return null if name == class_name
        return null if name == "~${class_name}"

        throw "${where}: conversion operators are not supported"
      end

      var return_type = cast_type(member.child_from_type(:decltype).content)
      var lavi_name = lavi_name_of(name, where)

      // Predicates are named with a question mark in Lavi, such as 'open?' for 'bool is_open()'
      if return_type == 'bool' && name.starts_with?('is_') && name.size > 3
        lavi_name = "${name.slice(3, name.size)}?"
      end

      return CXX::Method.new(name, lavi_name, has_specifier?(member, 'static'), parameters_of(member, where), return_type)
    end

    // The parameters of the constructor, which are the parameters of init. A Lavi class has a single init, so
    // more than one constructor is an error. Without a constructor, init has no parameters.
    fn collect_constructor_parameters(class_node, body)
      var class_name = class_node.decname
      var constructors = []

      body.children.each do (member)
        if member.fn_decl?
          // Constructors have no return type and the name of the class
          if member.child_from_type(:decltype) == null && member.decname == class_name
            constructors.push(member)
          end
        end
      end

      if constructors.size > 1
        throw "${class_name}: multiple constructors are not supported"
      end

      return [] if constructors.empty?

      return parameters_of(constructors[0], "${class_name}::${class_name}")
    end

    // The parameters of a function.
    fn parameters_of(function_node, where)
      var parameters = []

      function_node.child_from_type(:fn_params).children.each do (parameter)
        var type = parameter.child_from_type(:decltype).content

        if type == '...'
          throw "${where}: variadic functions are not supported"
        end

        if parameter.decname == null
          throw "${where}: unnamed parameters are not supported"
        end

        var default_value = parameter.child_from_type(:valuedecl)

        default_value = default_value.content if default_value != null

        parameters.push(CXX::Parameter.new(parameter.decname, cast_type(type), default_value))
      end

      return parameters
    end

    // The type an argument is cast to: the type of the parameter without the reference and the top level const,
    // such as 'bool' for 'const bool&' and 'char*' for 'char* const'. The const of the pointed type, such as in
    // 'const char*', is kept. A 'std::string_view' is cast to a 'std::string'.
    fn cast_type(type)
      var result = type.strip

      result = remove_suffix(result, '&')
      result = remove_suffix(result, '&')
      result = remove_suffix(result, ' const')

      // In pointers, the leading const belongs to the pointed type
      unless result.ends_with?('*')
        result = result.slice(6, result.size).strip if result.starts_with?('const ')
      end

      // A string_view does not own its characters, so the argument is cast to a std::string, which lives until the
      // end of the call and converts to the std::string_view of the parameter.
      result = 'std::string' if result == 'std::string_view'

      return result
    end

    fn remove_suffix(text, suffix)
      return text unless text.ends_with?(suffix)

      return text.slice(0, text.size - suffix.size).strip
    end

    // The Lavi name of a method: the same name, or the symbol of operators, such as '==' for 'operator=='.
    fn lavi_name_of(name, where)
      return name unless name.starts_with?('operator')

      var symbol = name.slice(8, name.size).strip
      var first = symbol.front

      // Identifiers which start with 'operator', such as 'operators'
      return name if first == null
      return name if first.alnum? || first == '_'

      if symbol == '()' || symbol.starts_with?('new') || symbol.starts_with?('delete')
        throw "${where}: the operator is not supported"
      end

      return symbol
    end

    fn has_specifier?(function_node, specifier)
      var found = false

      function_node.children.each do (child)
        found = true if child.declspec? && child.content == specifier
      end

      return found
    end

    fn has_qualifier?(function_node, qualifier)
      var found = false

      function_node.children.each do (child)
        found = true if child.fn_qualifier? && child.content == qualifier
      end

      return found
    end

    // Names

    // A new array with the items of the list. Objects have value semantics, but this makes the copy explicit.
    fn copy(list)
      var result = []

      list.each do (item)
        result.push(item)
      end

      return result
    end

    // main_frame to MainFrame
    fn pascal_case(name)
      var result = ''

      name.split('_').each do (word)
        word.capitalize!
        result += word
      end

      return result
    end

    // Source

    // The C++ source.
    fn generate
      var source = "// Generated by 'lavi cxx'. Do not edit.\n"

      source += "\n"
      source += "#include <lavi/lang/api.hpp>\n"
      source += "#include <lavi/lang/classes.hpp>\n"
      source += "#include <lavi/lang/interpreter.hpp>\n"
      source += "\n"
      source += "#include <memory>\n"
      source += "\n"
      source += "#include \"${header_path}\"\n"

      bindings.each do (binding)
        source += generate_class(binding)
      end

      return source
    end

    fn generate_class(binding)
      var klass = "${binding.identifier}_class"
      var source = "\n"

      source += "std::shared_ptr<lavi::lang::klass> create_${klass}()\n"
      source += "{\n"
      source += "  auto ${klass} = lavi::lang::klass::create_builtin(\"${binding.name}\");\n"
      source += "\n"
      source += generate_init(binding, klass)

      binding.methods.each do (method)
        source += generate_method(binding, klass, method)
      end

      source += "\n"
      source += "  return ${klass};\n"
      source += "}\n"

      return source
    end

    // The init creates the native object and sets it on the Lavi object.
    fn generate_init(binding, klass)
      var names = parameter_names(binding.constructor_parameters)
      var arguments = cast_arguments(binding.constructor_parameters)
      var source = ''

      source += "  ${klass}->instance_functions[\"init\"] = std::make_shared<lavi::lang::function>(\"init\", "
      source += "std::initializer_list<std::string>{ ${names.join(', ')} }, " unless names.empty?
      source += "[](lavi::lang::interpreter* interpreter) {\n"
      source += "    auto object = interpreter->current_context->self;\n"

      if positional_parameters?(binding.constructor_parameters)
        source += "    auto& params = interpreter->current_context->positional_params;\n"
      end

      source += "    object->set_native<std::shared_ptr<${binding.cxx_name}>>(std::make_shared<${binding.cxx_name}>(${arguments.join(', ')}));\n"
      source += "\n"
      source += "    return nullptr;\n"
      source += "  });\n"

      return source
    end

    // A method calls the native object, or the class for static methods.
    fn generate_method(binding, klass, method)
      var functions = 'instance_functions'
      var function = "native->${method.name}"

      if method.class_function
        functions = 'functions'
        function = "${binding.cxx_name}::${method.name}"
      end

      var source = "\n"

      var names = parameter_names(method.parameters)
      var arguments = cast_arguments(method.parameters)

      source += "  ${klass}->${functions}[\"${method.lavi_name}\"] = std::make_shared<lavi::lang::function>(\"${method.lavi_name}\", "
      source += "std::initializer_list<std::string>{ ${names.join(', ')} }, " unless names.empty?
      source += "[](lavi::lang::interpreter* interpreter) {\n"

      unless method.class_function
        source += "    auto& native = interpreter->current_context->self->as<std::shared_ptr<${binding.cxx_name}>>();\n"
      end

      if positional_parameters?(method.parameters)
        source += "    auto& params = interpreter->current_context->positional_params;\n"
      end

      source += "\n" unless method.class_function && names.empty?

      // Only bool is returned for now, the other values are discarded
      if method.return_type == 'bool'
        source += "    return lavi::lang::api::to_object(interpreter, ${function}(${arguments.join(', ')}));\n"
      else
        source += "    ${function}(${arguments.join(', ')});\n"
        source += "\n"
        source += "    return nullptr;\n"
      end

      source += "  });\n"

      return source
    end

    // The names of the parameters of a Lavi function, quoted for the C++ source. A parameter with a default value is
    // named, such as 'maximized: false'.
    fn parameter_names(parameters)
      var names = []

      parameters.each do (parameter)
        if parameter.default_value == null
          names.push("\"${parameter.name}\"")
        else
          names.push("\"${parameter.name}: ${escape(parameter.default_value)}\"")
        end
      end

      return names
    end

    // Whether any parameter is positional, that is, has no default value.
    fn positional_parameters?(parameters)
      var positional = parameters.find do (parameter)
        parameter.default_value == null
      end

      return positional != null
    end

    // The arguments of the C++ call, casting each Lavi argument to the type of its parameter. The positional
    // arguments are indexed in the order of the parameters, the named ones are found by name.
    fn cast_arguments(parameters)
      var arguments = []
      var index = 0

      parameters.each do (parameter)
        var argument = "interpreter->current_context->named_params[\"${parameter.name}\"]"

        if parameter.default_value == null
          argument = "params[${index}]"

          index += 1
        end

        arguments.push("lavi::lang::api::cast<${parameter.type}>(interpreter, ${argument})")
      end

      return arguments
    end

    // Escapes the text for a C++ string literal.
    fn escape(text)
      var result = ''
      var index = 0

      loop while index < text.size
        var character = text.slice(index, 1)

        result += "\\" if character == "\"" || character == "\\"
        result += character

        index += 1
      end

      return result
    end
  end
end
