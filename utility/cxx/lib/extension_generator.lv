namespace CXX
  // Generates the C++ source of the extension loaded by 'import :<name>'. It declares the create functions of
  // the classes of all headers (CXX::Generator) and loads the classes in the interpreter, like the builtin
  // extensions in src/builtin_libs of the Lavi language.
  class ExtensionGenerator
    // The name of the extension, such as 'lavi-gui'.
    var name = null
    var bindings = []

    fn init(n, b)
      name = n
      bindings = b
    end

    // The name of the C++ class of the extension, such as 'lavi_gui_extension'. The characters which are not
    // valid in an identifier, such as '-', are replaced by '_'.
    fn extension_class
      var identifier = ''
      var i = 0

      loop while i < name.size
        var c = name[i]

        if c.alnum? || c == '_'
          identifier += c
        else
          identifier += '_'
        end

        i += 1
      end

      identifier = "_${identifier}" if identifier.front.digit?

      return "${identifier}_extension"
    end

    fn generate
      var extension = extension_class
      var source = "// Generated by 'lavi cxx'. Do not edit.\n"

      source += "\n"
      source += "#include <lavi/lang/api.hpp>\n"
      source += "#include <lavi/lang/extension.hpp>\n"
      source += "#include <lavi/lang/interpreter.hpp>\n"
      source += "\n"
      source += "#include <memory>\n"
      source += "\n"

      bindings.each do (binding)
        source += "extern std::shared_ptr<lavi::lang::klass> create_${binding.identifier}_class();\n"
      end

      source += "\n"
      source += "class ${extension} : public lavi::lang::extension\n"
      source += "{\n"
      source += "public:\n"
      source += "  ${extension}() : lavi::lang::extension(\"${name}\")\n"
      source += "  {\n"
      source += "  }\n"
      source += "\n"
      source += "  virtual void load(lavi::lang::interpreter* interpreter) override\n"
      source += "  {\n"

      bindings.each do (binding)
        source += "    interpreter->load(create_${binding.identifier}_class());\n"
      end

      source += "  }\n"
      source += "};\n"
      source += "\n"
      source += "LAVI_EXTENSION(${extension})\n"

      return source
    end
  end
end
