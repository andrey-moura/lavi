#include 'std/tests.lv'

describe 'Hash' do
  context 'declaration' do
    context 'with literal syntax' do
      context 'using symbol keys' do
        var hash = { key: "value" }
        it 'allows accessing values with symbol keys' do
          expect(hash[:key]).to eq("value")
        end
        it 'allows accessing values with string keys' do
          expect(hash["key"]).to eq("value")
        end
        it 'allows accessing values with the operator.' do
          expect(hash.key).to eq("value")
        end
      end
      context 'using string keys' do
        var hash = { "key": "value" }
        it 'allows accessing values with symbol keys' do
          expect(hash[:key]).to eq("value")
        end
        it 'allows accessing values with string keys' do
          expect(hash["key"]).to eq("value")
        end
        it 'allows accessing values with the operator.' do
          expect(hash.key).to eq("value")
        end
      end
    end
  end
  describe 'declaration' do
    it 'accepts delimiters as string keys' do
      var hash = { "{": 1, "}": 2, ",": 3 }

      expect(hash["{"]).to eq(1)
      expect(hash["}"]).to eq(2)
      expect(hash[","]).to eq(3)
    end
  end
end
