#include 'std/tests'

describe 'String' do
  describe 'split' do
    it 'splits a string into an array of substrings based on a delimiter' do
      var str = 'Hello,World,This,Is,A,Test'
      var result = str.split(',')

      expect(result).to eq(['Hello', 'World', 'This', 'Is', 'A', 'Test'])
    end
    context 'when the delimiter is not found in the string' do
      it 'returns an array containing the original string' do
        var str = 'Hello World'
        var result = str.split(',')

        expect(result).to eq(['Hello World'])
      end
    end
    it 'does not modify the original string' do
      var str = 'Hello,World,This,Is,A,Test'
      var result = str.split(',')

      expect(str).to eq('Hello,World,This,Is,A,Test')
    end
  end
  describe 'strip' do
    context 'when the string has leading and trailing whitespace' do
      it 'removes the whitespace from both ends of the string' do
        var str = "\n\r\t hello world \n\r\t"
        var stripped_str = str.strip

        expect(stripped_str).to eq('hello world')
      end
    end
    context 'when the string has no leading or trailing whitespace' do
      it 'returns the original string' do
        var str = 'hello world'
        var stripped_str = str.strip

        expect(stripped_str).to eq('hello world')
      end
    end
    it 'does not modify the original string' do
      var str = "\n\r\t hello world \n\r\t"
      var stripped_str = str.strip

      expect(str).to eq("\n\r\t hello world \n\r\t")
    end
  end
  describe 'lower!' do
    it 'converts all characters in the string to lowercase in place' do
      var str = 'HeLLo WoRLD'
      str.lower!

      expect(str).to eq('hello world')
    end
    it 'returns null' do
      var str = 'HeLLo WoRLD'
      expect(str.lower!).to eq(null)
    end
  end
  describe 'lower' do
    it 'converts all characters in the string to lowercase' do
      var str = 'HeLLo WoRLD'
      var lower_str = str.lower

      expect(lower_str).to eq('hello world')
    end
    it 'does not modify the original string' do
      var str = 'HeLLo WoRLD'
      var lower_str = str.lower

      expect(str).to eq('HeLLo WoRLD')
    end
  end
  describe 'operator<' do
    context 'when comparing two strings' do
      it 'returns true if the first string is less than the second string' do
        var str1 = 'apple'
        var str2 = 'banana'

        expect(str1 < str2).to eq(true)
      end

      it 'returns false if the first string is not less than the second string' do
        var str1 = 'banana'
        var str2 = 'apple'

        expect(str1 < str2).to eq(false)
      end
    end
  end
  describe 'find' do
    it 'returns the position of the text' do
      expect('abcabc'.find('b')).to eq(1)
    end
    it 'starts searching at the given position' do
      expect('abcabc'.find('b', 2)).to eq(4)
    end
    it 'returns -1 when the text is not found' do
      expect('abc'.find('z')).to eq(-1)
      expect('abc'.find('a', 10)).to eq(-1)
    end
  end
  describe '#alpha?' do
    it 'returns true when every character is one of the letters' do
      expect('abcXYZ'.alpha?).to eq(true)
    end
    it 'returns false when the string has a non letter' do
      expect('ab1'.alpha?).to eq(false)
    end
    it 'returns false for an empty string' do
      expect(''.alpha?).to eq(false)
    end
  end
  describe '#digit?' do
    it 'returns true when every character is one of the decimal digits' do
      expect('0123456789'.digit?).to eq(true)
    end
    it 'returns false when the string has a non digit' do
      expect('12a'.digit?).to eq(false)
    end
    it 'returns false for an empty string' do
      expect(''.digit?).to eq(false)
    end
  end
  describe '#xdigit?' do
    it 'returns true when every character is one of the hexadecimal digits' do
      expect('09afAF'.xdigit?).to eq(true)
    end
    it 'returns false when the string has a non hexadecimal digit' do
      expect('1g'.xdigit?).to eq(false)
    end
    it 'returns false for an empty string' do
      expect(''.xdigit?).to eq(false)
    end
  end
  describe '#alnum?' do
    it 'returns true when every character is one of the letters or digits' do
      expect('abc123'.alnum?).to eq(true)
    end
    it 'returns false when the string has a character that is not a letter or digit' do
      expect('a_1'.alnum?).to eq(false)
    end
    it 'returns false for an empty string' do
      expect(''.alnum?).to eq(false)
    end
  end
  describe '#space?' do
    it 'returns true when every character is one of the whitespaces' do
      expect(" \t\n\r".space?).to eq(true)
    end
    it 'returns false when the string has a non whitespace' do
      expect(' a '.space?).to eq(false)
    end
    it 'returns false for an empty string' do
      expect(''.space?).to eq(false)
    end
  end
  describe 'front' do
    it 'returns null for an empty string' do
      expect(''.front).to eq(null)
    end
  end
end
