#include 'std/tests'

describe 'String' do
  describe 'operator<' do
    context 'when comparing two strings' do
      it 'returns true if the first string is less than the second string' do
        var str1 = "apple"
        var str2 = "banana"

        expect(str1 < str2).to eq(true)
      end

      it 'returns false if the first string is not less than the second string' do
        var str1 = "banana"
        var str2 = "apple"

        expect(str1 < str2).to eq(false)
      end
    end
  end
  describe 'front' do
    it 'returns null for an empty string' do
      expect(''.front).to eq(null)
    end
  end
  describe 'operator==' do
    it 'returns false when comparing with an object of other class' do
      expect('a' == null).to eq(false)
      expect('1' == 1).to eq(false)
    end
  end
  describe 'operator!=' do
    it 'returns true when comparing with an object of other class' do
      expect('a' != null).to eq(true)
      expect('1' != 1).to eq(true)
    end
  end
end
