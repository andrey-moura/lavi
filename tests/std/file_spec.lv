#include 'std/tests.lv'

// Files created by the specs are kept in the temporary directory
fn spec_file_path
  Dir.temp.path / "lavi_spec_${Random.integer}.txt"
end

describe 'File' do
  describe '#write' do
    it 'writes content to a file' do
      var path = spec_file_path
      File.create(path).write("Hello, World!")
      var content = File.read(path)
      expect(content).to eq("Hello, World!")
    end
  end
  describe '.exists?' do
    context 'when the file exists' do
      it 'returns true' do
        expect(File.exists?(__file__)).to eq(true)
      end
    end

    context 'when the file does not exist' do
      it 'returns false' do
        expect(File.exists?('non_existing_file.txt')).to eq(false)
      end
    end
  end
  describe '.create' do
    it 'creates a new file' do
      var path = spec_file_path
      expect(File.exists?(path)).to eq(false)
      File.create(path)
      expect(File.exists?(path)).to eq(true)
    end
    it 'returns a file object' do
      var path = spec_file_path
      var file = File.create(path)
      expect(file).to be_a(File)
      expect(File.exists?(path)).to eq(true)
    end
  end
  describe '.read' do
    it 'reads the content of a file' do
      var content = File.read('tests/fixtures/1.txt')
      expect(content).to eq('1')
    end
  end
end