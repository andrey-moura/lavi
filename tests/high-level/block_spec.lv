#include 'std/tests.lv'

fn yield_one_and_two
  yield 1
  yield 2
end

describe 'block' do
  context 'when break is called' do
    it 'stops the execution' do
      var count = 0

      yield_one_and_two do (value)
        count += 1
        break
        count += 1
      end

      expect(count).to eq(1)
    end
  end
  context 'when next is called' do
    it 'skips to the next iteration' do
      var count = 0

      yield_one_and_two do (value)
        count += 1
        next
        count += 1
      end
      expect(count).to eq(2)
    end
  end
end
